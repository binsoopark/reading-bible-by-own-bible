    <string name="help_book_chapter_title">Choose book and chapter</string><string name="help_book_chapter_detail">Tap the book name at the top to choose a testament, book, and chapter. Tap a chapter to open it.</string><string name="help_prev_next_title">Previous/next chapter</string><string name="help_prev_next_detail">Use ◀ ▶ or swipe horizontally across the text to change chapters.</string><string name="help_version_compare_title">Version and comparison</string><string name="help_version_compare_detail">Use Version to change the translation and Compare to show another version beside it.</string>
    <string name="help_swipe_title">Horizontal swipe</string><string name="help_swipe_detail">Swipe the reading area left or right to move to the next or previous chapter.</string><string name="help_pinch_title">Pinch zoom</string><string name="help_pinch_detail">When Multitouch zoom is enabled in Settings, pinch with two fingers to change text size.</string><string name="help_keyboard_title">Dismiss keyboard</string><string name="help_keyboard_detail">Tap an empty area, scroll a list, or change tabs to dismiss the keyboard.</string>
    <string name="help_bookmark_detail">Tap the bookmark icon to toggle a bookmark. Find it under the Bookmarks filter in Records.</string><string name="help_range_highlight_title">Range selection and highlights</string><string name="help_range_highlight_detail">Long-press a verse, then tap another verse to select the whole range. Use the highlight button to apply one color to all selected verses.</string><string name="help_read_check_title">Read marker</string><string name="help_read_check_detail">Use the circle icon to mark a verse read, then find it under the Read filter.</string><string name="help_verse_note_title">Verse note</string><string name="help_verse_note_detail">Tap the note icon to add or edit a verse note. Find it under the Notes filter.</string><string name="help_note_icon_title">Note indicator</string><string name="help_note_icon_detail">When Show note indicators is enabled, an indicator appears beside verses with notes.</string>
    <string name="help_selection_start_title">Start selection</string><string name="help_selection_start_detail">Long-press a verse card to enter selection mode.</string><string name="help_selection_toggle_title">Add or remove</string><string name="help_selection_toggle_detail">In selection mode, tap another verse to add or remove it.</string><string name="help_copy_share_title">Copy and share</string><string name="help_copy_share_reader_detail">Copy and Share appear when verses are selected, so you can send several verses at once.</string>
