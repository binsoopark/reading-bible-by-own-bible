    <string name="help_title">사용 방법</string>
    <string name="help_getting_started">시작하기</string>
    <string name="help_intro">이 앱은 Lifove Bible과 호환되는 bdf/lfa 성경 데이터 파일을 사용자가 직접 불러와 읽는 앱입니다.\n앱 안에 성경 본문이 포함되어 있지 않으므로, 먼저 설정에서 데이터 폴더를 선택하거나 샘플 데이터를 내려받아 주세요.</string>
    <string name="help_section_tabs">하단 탭</string>
    <string name="help_section_reader_basic">읽기 탭 — 기본</string>
    <string name="help_section_reader_gestures">읽기 탭 — 제스처</string>
    <string name="help_section_reader_actions">읽기 탭 — 절 아이콘</string>
    <string name="help_section_reader_selection">읽기 탭 — 여러 절 선택</string>
    <string name="help_section_search">검색 탭</string>
    <string name="help_section_records">메모 탭</string>
    <string name="help_section_personal_notes">개인메모 탭</string>
    <string name="help_section_settings">설정 탭</string>
    <string name="help_tab_reader_detail">성경 본문을 읽고, 북마크·형광펜·읽음 표시를 할 수 있습니다.</string>
    <string name="help_tab_search_detail">현재 역본에서 구절을 검색합니다. 결과를 길게 누르면 읽기 탭으로 이동합니다.</string>
    <string name="help_tab_records_detail">북마크, 형광펜, 읽음, 구절 메모를 종류별로 나눠 볼 수 있습니다.</string>
    <string name="help_tab_personal_notes_detail">성경 구절과 무관한 자유 메모를 작성합니다. + 버튼으로 추가하고, 스와이프로 수정·삭제할 수 있습니다.</string>
    <string name="help_tab_settings_detail">데이터 폴더, 읽기 스타일, 기록 백업, 이 도움말을 확인할 수 있습니다.</string>
    <string name="help_book_chapter_title">책·장 선택</string>
    <string name="help_book_chapter_detail">상단의 책 이름을 누르면 구약/신약, 책, 장을 고를 수 있습니다. 장을 탭하면 바로 이동합니다.</string>
    <string name="help_prev_next_title">이전/다음 장</string>
    <string name="help_prev_next_detail">◀ ▶ 버튼 또는 본문을 좌우로 스와이프하면 장을 넘길 수 있습니다.</string>
    <string name="help_version_compare_title">역본·비교</string>
    <string name="help_version_compare_detail">역본 버튼으로 읽을 번역본을 바꿉니다. 비교 버튼으로 다른 역본을 함께 볼 수 있습니다.</string>
    <string name="help_swipe_title">좌우 스와이프</string>
    <string name="help_swipe_detail">본문 영역에서 손가락을 좌우로 밀면 이전 장·다음 장으로 이동합니다.</string>
    <string name="help_pinch_title">핀치 줌 (두 손가락)</string>
    <string name="help_pinch_detail">설정에서 ‘멀티터치 줌 사용’이 켜져 있을 때, 두 손가락으로 벌리거나 오므려 글자 크기를 조절합니다.</string>
    <string name="help_keyboard_title">키보드 내리기</string>
    <string name="help_keyboard_detail">입력 중 빈 곳을 탭하거나, 목록을 스크롤하거나, 다른 탭으로 이동하면 키보드가 내려갑니다.</string>
    <string name="help_bookmark_detail">책갈피 아이콘을 누르면 북마크를 켜거나 끕니다. 메모 탭의 ‘북마크’ 필터에서 볼 수 있습니다.</string>
    <string name="help_range_highlight_title">범위 선택·형광펜</string>
    <string name="help_range_highlight_detail">구절을 길게 누르고 다른 구절을 누르면 그 사이가 모두 선택됩니다. 선택 바의 형광펜 버튼으로 범위 전체에 같은 색을 적용할 수 있습니다.</string>
    <string name="help_read_check_title">읽음 체크</string>
    <string name="help_read_check_detail">동그라미 아이콘으로 읽은 절을 표시합니다. 메모 탭의 ‘읽음’ 필터에서 모아 볼 수 있습니다.</string>
    <string name="help_verse_note_title">구절 메모</string>
    <string name="help_verse_note_detail">메모 아이콘을 누르면 해당 절에 메모를 작성·수정할 수 있습니다. 메모 탭의 ‘메모’ 필터에서 모아 볼 수 있습니다.</string>
    <string name="help_note_icon_title">메모 아이콘</string>
    <string name="help_note_icon_detail">설정에서 ‘본문 메모 아이콘 표시’가 켜져 있으면, 메모가 있는 절 옆에 표시가 보입니다.</string>
    <string name="help_selection_start_title">선택 시작</string>
    <string name="help_selection_start_detail">절 카드를 길게 누르면 선택 모드가 시작됩니다.</string>
    <string name="help_selection_toggle_title">선택 추가/해제</string>
    <string name="help_selection_toggle_detail">선택 모드에서 다른 절을 탭하면 선택에 추가하거나 빼낼 수 있습니다.</string>
    <string name="help_copy_share_title">복사·공유</string>
    <string name="help_copy_share_reader_detail">선택한 절이 있으면 상단에 ‘복사’와 ‘공유’ 버튼이 나타납니다. 여러 절을 한 번에 복사하거나 다른 앱으로 보낼 수 있습니다.</string>
    <string name="help_search_title">검색하기</string>
    <string name="help_search_detail">두 글자 이상 입력 후 검색 버튼 또는 키보드의 검색(↵)을 누르세요.</string>
    <string name="help_more_results_title">결과 더 보기</string>
    <string name="help_more_results_detail">결과가 많으면 목록 아래 ‘더 보기’로 추가 결과를 불러옵니다.</string>
    <string name="help_open_reader_title">읽기로 이동</string>
    <string name="help_open_reader_detail">검색 결과를 길게 누르면 해당 구절이 있는 읽기 화면으로 이동합니다.</string>
    <string name="help_record_types_title">종류별 보기</string>
    <string name="help_record_types_detail">상단 세그먼트에서 북마크 / 형광펜 / 읽음 / 메모 중 하나를 고릅니다. 각 종류만 따로 모아 볼 수 있습니다.</string>
    <string name="help_highlight_color_title">형광펜 색</string>
    <string name="help_highlight_color_detail">형광펜 필터에서는 ‘노랑’ 같은 글자 대신 색상 원(●)으로 표시됩니다.</string>
    <string name="help_verse_note_records_detail">읽기 탭에서 절의 메모 아이콘을 눌러 작성하거나, 메모 탭 카드의 메모 칸에서 수정할 수 있습니다.</string>
    <string name="help_copy_share_records_detail">메모 항목을 길게 눌러 선택한 뒤, 복사 또는 공유할 수 있습니다.</string>
    <string name="help_add_note_title">메모 추가</string>
    <string name="help_add_note_detail">오른쪽 아래 + 버튼을 누르면 제목과 내용을 적어 새 개인메모를 만듭니다.</string>
    <string name="help_edit_delete_title">수정·삭제</string>
    <string name="help_edit_delete_detail">목록에서 항목을 왼쪽으로 밀면 수정·삭제 버튼이 나타납니다. 탭하면 편집하거나 삭제할 수 있습니다.</string>
    <string name="help_backup_detail">길게 눌러 여러 메모를 선택한 뒤 ‘백업’을 누르면 .rmb-notes.json 파일로 저장합니다.</string>
    <string name="help_restore_detail">‘복원’을 누른 뒤 이전에 백업한 개인메모 파일을 선택하면 메모를 불러옵니다. 기존 메모와 합쳐집니다.</string>
    <string name="help_bible_data_title">성경 데이터</string>
    <string name="help_bible_data_detail">bdf/lfa 파일이 있는 폴더를 선택하거나, 데이터가 없을 때만 샘플 다운로드를 이용할 수 있습니다.</string>
    <string name="help_reading_style_title">읽기 스타일</string>
    <string name="help_reading_style_detail">글자 크기, 줄 간격, 색상 팔레트, 화면 켜짐 유지, 멀티터치 줌 등을 조절합니다.</string>
    <string name="help_record_backup_title">기록 백업</string>
    <string name="help_record_backup_detail">북마크·구절 메모·형광펜·읽음 표시를 JSON으로 내보내거나 가져올 수 있습니다. 개인메모는 개인메모 탭에서 별도로 백업합니다.</string>
    <string name="unknown">알 수 없음</string><string name="settings_export_success">구절 기록을 내보냈습니다.</string><string name="settings_export_failure">내보내기에 실패했습니다.</string><string name="settings_import_success">구절 기록을 가져왔습니다.</string><string name="settings_import_failure">가져오기에 실패했습니다.</string><string name="settings_back">설정으로 돌아가기</string><string name="settings_help_title">사용 방법 도움말</string><string name="settings_help_description">탭별 기능, 길게 누르기, 스와이프 등 사용 방법을 확인할 수 있습니다.</string><string name="settings_help_action">도움말 보기</string><string name="settings_data_folder">성경 데이터 폴더</string><string name="settings_no_folder">아직 선택한 폴더가 없습니다. 선택하지 않으면 기본 /sdcard/bible 폴더를 시도합니다.</string><string name="settings_choose_folder">bdf/lfa 폴더 선택</string><string name="settings_getting_started">처음 시작</string><string name="settings_step_one">1. Lifove Bible 호환 bdf/lfa 파일이 들어 있는 폴더를 선택합니다.</string><string name="settings_step_two">2. 설정의 성경 파일 확인에서 감지된 파일과 누락 파일을 확인합니다.</string><string name="settings_step_three">3. 읽기 탭에서 역본, 책, 장을 선택해 읽습니다.</string><string name="settings_data_notice">이 앱은 성경 본문 데이터를 포함하지 않으며, 사용자가 가진 파일을 읽습니다.</string><string name="settings_check_files">성경 파일 확인</string><string name="settings_check_files_description">선택한 bdf/lfa 폴더의 역본, 오디오 파일, 누락 파일과 진단 결과를 확인합니다.</string><string name="settings_check_files_action">성경 파일 확인하기</string><string name="settings_records_transfer">기록 가져오기 / 내보내기</string><string name="settings_records_transfer_description">북마크, 메모, 하이라이트, 읽음 체크를 JSON 파일로 백업하거나 복원합니다.</string><string name="settings_export">내보내기</string><string name="settings_import">가져오기</string><string name="settings_app_info">앱 정보</string><string name="settings_download_title">성경 데이터 다운로드</string><string name="settings_download_notice">사용자의 성경 데이터가 없을 경우 편의를 위해 별도의 성경 데이터 다운로드 기능을 제공합니다. 성경 데이터를 구할 수 없는 경우에 한해, 제한적으로 다운로드를 이용해 주세요.</string><string name="settings_download_detail">GitHub Release에서 약 49MB의 bible.zip 파일을 내려받아 앱 전용 폴더에 압축 해제하고 바로 적용합니다. 이미 bdf/lfa 폴더를 선택했거나 성경 데이터가 감지되면 다운로드할 수 없습니다.</string><string name="settings_installed_folder">적용된 폴더: %1$s</string><string name="settings_download_action">다운로드 및 적용</string><string name="settings_reading_style">읽기 스타일</string><string name="settings_keep_screen_on">화면 꺼지지 않도록 유지</string><string name="settings_keep_screen_on_description">본문을 읽는 동안 화면 자동 꺼짐을 막습니다.</string><string name="settings_multitouch_zoom">멀티터치 줌 사용</string><string name="settings_multitouch_zoom_description">본문에서 두 손가락으로 글자 크기를 조절합니다.</string><string name="settings_bold_text">볼드체 적용</string><string name="settings_bold_text_description">본문 성경 구절을 굵게 표시합니다.</string><string name="settings_note_icon">본문 메모 아이콘 표시</string><string name="settings_note_icon_description">메모가 작성된 절 옆에 표시를 보여줍니다.</string><string name="settings_font_size">글자 크기</string><string name="settings_line_spacing">본문 줄 간격</string><string name="settings_palette">팔레트</string>
    <string name="widget_body">내가 가진 성경 파일로 이어서 읽기</string><string name="library_title">성경 파일</string><string name="library_audio">오디오 파일</string><string name="library_no_audio">감지된 MP3 파일이 없습니다.</string><string name="library_more_audio">그 외 %1$d개 파일이 더 있습니다.</string><string name="library_data_location">데이터 위치</string><string name="library_scanning_selected">설정 탭에서 선택한 폴더를 검사 중입니다.</string><string name="library_scanning_default">선택한 폴더가 없어 기본 /sdcard/bible 폴더를 검사합니다.</string><string name="library_all_files">전체 파일</string><string name="library_versions">역본</string><string name="library_file_count">%1$d개</string><string name="library_complete_bdf">완성 bdf</string><string name="library_issues">이슈</string><string name="library_detected_versions">감지된 역본</string><string name="library_no_versions">읽을 수 있는 역본이 아직 없습니다.</string><string name="library_diagnostics">진단 결과</string><string name="library_diagnostics_ok">큰 문제 없이 읽을 수 있는 데이터 폴더로 보입니다.</string><string name="severity_error">오류</string><string name="severity_warning">주의</string><string name="severity_info">정보</string>
    <string name="diagnostic_default_missing_title">기본 폴더가 없습니다</string><string name="diagnostic_default_missing_detail">%1$s 폴더를 찾지 못했습니다. 설정 탭에서 bdf/lfa 폴더를 선택해 주세요.</string><string name="diagnostic_not_folder_title">폴더가 아닙니다</string><string name="diagnostic_path_is_file">%1$s 경로가 파일로 감지되었습니다.</string><string name="diagnostic_cannot_open_title">선택한 폴더를 열 수 없습니다</string><string name="diagnostic_cannot_open_detail">저장소 권한이 사라졌거나 폴더가 이동되었을 수 있습니다. 설정 탭에서 폴더를 다시 선택해 주세요.</string><string name="diagnostic_uri_not_folder">선택된 URI가 폴더로 인식되지 않습니다.</string><string name="diagnostic_empty_title">폴더가 비어 있습니다</string><string name="diagnostic_empty_detail">이 폴더에서 bdf/lfa 파일을 찾을 수 없습니다.</string><string name="diagnostic_incomplete_bdf_title">%1$s bdf 파일이 일부 없습니다</string><string name="diagnostic_missing_files">누락된 분할 파일: %1$s</string><string name="diagnostic_lfb_title">.lfb 파일이 감지되었습니다</string><string name="diagnostic_lfb_detail">현재 MVP는 .bdf와 .lfa 읽기를 우선 지원합니다. .lfb는 이후 단계에서 구조 분석 후 연결할 예정입니다.</string><string name="diagnostic_mp3_title">MP3 파일이 감지되었습니다</string><string name="diagnostic_mp3_detail">오디오 파일 %1$d개가 있습니다. 현재 단계에서는 감지만 지원하고, 재생 UI는 이후 오디오 플레이어 단계에서 연결합니다.</string><string name="diagnostic_unknown_title">알 수 없는 파일이 있습니다</string><string name="diagnostic_unknown_detail">지원 포맷이 아닌 파일 %1$d개가 함께 있습니다.</string><string name="diagnostic_no_readable_title">읽을 수 있는 역본이 없습니다</string><string name="diagnostic_no_readable_detail">.lfa 파일이 없거나, .bdf 파일이 1~7번 세트로 완성되지 않았을 수 있습니다.</string>
    <string name="personal_notes_invalid_backup">개인메모 백업 파일 형식이 올바르지 않습니다.</string><string name="cache_saving">DB 캐시에 저장하는 중입니다</string><string name="cache_saved">캐시 저장 완료</string><string name="download_existing_data">이미 성경 데이터가 있습니다. 다운로드는 데이터가 없을 때만 이용할 수 있습니다.</string><string name="download_downloading">성경 데이터 파일을 다운로드하는 중입니다.</string><string name="download_verifying">다운로드 파일을 확인하는 중입니다.</string><string name="download_checksum_error">다운로드한 파일의 체크섬이 일치하지 않습니다.</string><string name="download_extracting">성경 데이터 압축을 해제하는 중입니다.</string><string name="download_apply_error">압축 해제한 폴더를 적용하지 못했습니다.</string><string name="download_success">성경 데이터를 다운로드하고 적용했습니다.</string><string name="download_failure">성경 데이터 다운로드에 실패했습니다. %1$s</string><string name="bootstrap_checking_folder">성경 데이터 폴더를 확인하는 중입니다.</string><string name="bootstrap_last_chapter">마지막으로 읽던 %1$s %2$d장을 준비하는 중입니다.</string><string name="bootstrap_comparison">비교 역본 본문을 미리 읽는 중입니다.</string><string name="bootstrap_cache_version">%1$s 역본을 빠른 실행용 DB 캐시로 준비 중입니다. %2$s</string><string name="zip_unsafe_path">안전하지 않은 압축 경로입니다.</string>
