    <string name="help_record_types_title">Filter by type</string><string name="help_record_types_detail">Choose Bookmarks, Highlights, Read, or Notes to view only that record type.</string><string name="help_highlight_color_title">Highlight color</string><string name="help_highlight_color_detail">Highlights are shown as colored circles rather than color names.</string><string name="help_verse_note_records_detail">Add a note from the verse note icon in Read or edit it in a Records card.</string><string name="help_copy_share_records_detail">Long-press record items to select, copy, or share them.</string>
    <string name="help_add_note_title">Add note</string><string name="help_add_note_detail">Tap + at the lower right to create a personal note with a title and body.</string><string name="help_edit_delete_title">Edit or delete</string><string name="help_edit_delete_detail">Swipe an item left to reveal Edit and Delete.</string><string name="help_backup_detail">Select notes with a long press, then tap Back up to save an .rmb-notes.json file.</string><string name="help_restore_detail">Tap Restore and choose a previous backup. Restored notes are merged with existing notes.</string>
